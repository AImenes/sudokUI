// Cloudflare deployment config. sudokUI is a static PWA: `npx wrangler
// deploy` uploads dist/ to Cloudflare's edge, and a request that matches a
// file there is served without running any code. The Worker script
// (worker/index.ts) runs only for the paths that are not files: the share
// addresses, /p/<puzzle>, which it renders with a preview for chat apps
// and crawlers (docs/online-goals.md, phase 1). With this file present,
// wrangler skips its framework auto-detection (which would demand
// Vite >= 6) and just ships.
{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "sudokui",
  "main": "worker/index.ts",
  "compatibility_date": "2026-07-01",
  "assets": {
    "directory": "./dist",
    // what the Worker reaches the files through (env.ASSETS)
    "binding": "ASSETS",
    // a path that is neither a file nor a share address is a real 404: the
    // Worker hands it back here (answering it with the app shell would be
    // a "soft 404" to crawlers)
    "not_found_handling": "404-page",
    "html_handling": "auto-trailing-slash"
  }
  // Phase 2 (the shared daily with global stats) adds the database:
  // "d1_databases": [
  //   { "binding": "DB", "database_name": "sudokui-db", "database_id": "1957ccc7-7b13-45e3-92d4-f193a51d5e9a" }
  // ]
}
