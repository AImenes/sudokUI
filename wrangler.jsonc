// Cloudflare deployment config: sudokUI is a fully static PWA, so this is an
// assets-only Worker — `npx wrangler deploy` uploads dist/ to Cloudflare's
// edge, no server code involved. With this file present, wrangler skips its
// framework auto-detection (which would demand Vite >= 6) and just ships.
{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "sudokui",
  "compatibility_date": "2026-07-01",
  "assets": {
    "directory": "./dist",
    // the app uses hash routing only, so an unknown path is a real 404
    // (answering it with the app shell would be a "soft 404" to crawlers)
    "not_found_handling": "404-page",
    "html_handling": "auto-trailing-slash"
  }
}
